FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build
COPY services/erp-api/pom.xml pom.xml
RUN mvn -B -q dependency:go-offline
COPY services/erp-api/src src
RUN mvn -B -q -DskipTests package
FROM eclipse-temurin:21-jre
RUN groupadd --system erp && useradd --system --gid erp --home-dir /app erp
WORKDIR /app
COPY --from=build --chown=erp:erp /build/target/erp-api-0.1.0.jar app.jar
USER erp
ENV BIND_ADDRESS=0.0.0.0
EXPOSE 8080
ENTRYPOINT ["java","-XX:MaxRAMPercentage=70","-Duser.timezone=Asia/Colombo","-jar","app.jar"]
