            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Manufacture"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed result; retry with same key returns prior result"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Role/CSRF denied"
          },
          "404": {
            "description": "Record not found or unowned"
          },
          "409": {
            "description": "State/stock/period/idempotency conflict"
          }
