  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{8,120}$"
        }
      },
      "CsrfToken": {
        "name": "X-CSRF-TOKEN",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Manufacture": {
        "type": "object",
        "required": [
          "bomId",
          "machineId",
          "quantity",
          "priority",
          "dueDate"
        ],
        "properties": {
          "bomId": {
            "type": "string",
            "minLength": 1
          },
          "machineId": {
            "type": "string",
            "minLength": 1
          },
          "salesOrderId": {
            "type": "string",
            "nullable": true
          },
          "quantity": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,6})?$"
              },
              {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0
              }
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "NORMAL",
              "HIGH",
              "URGENT"
            ]
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Complete": {
        "type": "object",
        "required": [
          "goodQty",
          "scrapQty",
          "labourCost",
          "machineCost",
          "notes"
        ],
        "properties": {
          "goodQty": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,6})?$"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "scrapQty": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,6})?$"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "labourCost": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,6})?$"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "machineCost": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d{1,6})?$"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Purchase": {
        "type": "object",
        "required": [
          "supplierId",
          "itemId",
          "quantity",
          "unitCost",
          "dueDate"
        ],
        "properties": {
          "supplierId": {
            "type": "string",
            "minLength": 1
          },
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "oneOf": [
              {
                "type": "string",
